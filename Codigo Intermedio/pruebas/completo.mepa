      INPP                { program completo; }
      RMEM  1             { var n: integer; }
      DSVS  L1
L2    ENPR  1             { function fact(k: integer): integer; }
      APVL  1,-3          { if k < 2 then }
      APCT  2
      CMME
      DSVF  L3
      APCT  1             { fact := 1 }
      ALVL  1,-4
      DSVS  L4
L3    NADA
      APVL  1,-3          { fact := k * fact(k - 1) }
      RMEM  1
      APVL  1,-3
      APCT  1
      SUST
      LLPR  L2
      MULT
      ALVL  1,-4
L4    NADA
      RTPR  1,1           { end; }
L5    ENPR  1             { procedure tabla(tope: integer); }
      RMEM  1             { var i: integer; }
      APCT  1             { i := 1; }
      ALVL  1,0
L6    NADA                { while i <= tope do }
      APVL  1,0
      APVL  1,-3
      CMNI
      DSVF  L7
      RMEM  1             { write(fact(i)); }
      APVL  1,0
      LLPR  L2
      IMPR
      APVL  1,0           { i := i + 1 }
      APCT  1
      SUMA
      ALVL  1,0
      DSVS  L6            { end }
L7    NADA
      LMEM  1             { end; }
      RTPR  1,1
L1    NADA
      LEER                { read(n); }
      ALVL  0,0
      APVL  0,0           { tabla(n) }
      LLPR  L5
      LMEM  1             { end. }
      PARA
